# Migration Environment Variables

# PostgreSQL 11 (Source)
OLD_CONTAINER=database-genki-db-1

# PostgreSQL 13 (Target)
NEW_CONTAINER=genki-db-pg13

# Database credentials
POSTGRES_USER=genki_dev

# Backup directory (for migrate_pg11_to_pg13.sh - backs up ALL databases)
BACKUP_DIR=/path/to/backup

# Target database for hypertable migration only (migrate_hypertables.sh)
# This is the database containing TimescaleDB hypertables
DB=genki
